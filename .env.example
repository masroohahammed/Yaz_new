# FM ERP / PFMS environment template
# Copy to `.env` and fill in real values. Never commit `.env`.

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
# Production (subfolder install): app.baseURL = 'https://pfms.alyazwa.com/public/'
app.allowedHostnames =

# Database — required. Do not put production passwords in source control.
database.default.hostname = localhost
database.default.database = your_database
database.default.username = your_username
database.default.password = your_password
database.default.DBDriver = MySQLi
database.default.port = 3306

# Encryption key (php spark key:generate). Required for sessions/CSRF in production.
encryption.key =
# After deploying this release: ROTATE THE DATABASE PASSWORD.
# The previous password was stored in source and must be treated as compromised.
