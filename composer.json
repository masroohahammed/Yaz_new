{
    "name": "alyazwa/fm-erp",
    "description": "Facility Management + Property Management ERP (CodeIgniter 4)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
